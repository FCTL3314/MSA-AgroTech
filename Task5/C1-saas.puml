@startuml C1-saas
!include <C4/C4_Context>

title C1. SaaS-платформа мониторинга скота, целевое состояние

Person(client_admin, "Администратор клиента", "Заводит фермы и пользователей, смотрит счета")
Person(client_user, "Сотрудники клиента", "Оператор, дежурный, зоотехник")
Person(integrator, "Разработчик клиента", "Подключает платформу к своим системам")
Person(support, "Поддержка платформы", "Ведёт клиентов, разбирает обращения")

System(saas, "SaaS-платформа мониторинга скота", "Мультитенантная: фермы клиентов, инциденты, метрики, подписки и биллинг, публичное API и панель самообслуживания")

System_Ext(agent, "Агенты на фермах клиентов", "Тот же агент, что и в варианте A. Ставится в хозяйстве клиента")
System_Ext(client_systems, "Системы клиента", "ERP, BI, хранилища. У каждого клиента свои")
System_Ext(payments, "Российские платёжные системы", "ЮKassa, СБП, счета для юрлиц")
System_Ext(mlmodel, "ML-модели партнёра")
System_Ext(idp, "Вход в платформу", "Собственные учётные записи или SSO клиента")

Rel(agent, saas, "События, инциденты, метрики использования", "HTTPS")
Rel(saas, agent, "Конфигурация и обновления моделей")
Rel(mlmodel, saas, "Обученные модели")
Rel(client_user, saas, "Работа с инцидентами и фермами")
Rel(client_admin, saas, "Фермы, пользователи, тариф, счета")
Rel(integrator, saas, "Публичное API и документация")
Rel(saas, client_systems, "Данные по API и вебхукам")
Rel(saas, payments, "Списания по подписке, счета и акты")
Rel(saas, idp, "Аутентификация")
Rel(support, saas, "Ведёт клиентов")

SHOW_LEGEND()
@enduml
