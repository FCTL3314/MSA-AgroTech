@startuml C3-main
!include <C4/C4_Component>

title C3. Вариант A: компоненты сервиса инцидентов на ферме

Person(duty, "Дежурный на ферме")
ContainerQueue(bus, "Локальная шина", "RabbitMQ", "Детекции, телеметрия, инциденты")
ContainerDb(farmdb, "Локальная БД", "PostgreSQL", "Инциденты, пороги правил, справочники")
Container(panel, "Панель дежурного", "Vue")
Container(sync, "Сервис синхронизации", "Python")
System_Ext(siren, "Сирена")

Container_Boundary(incidents, "Сервис инцидентов") {
  Component(consumer, "Подписчик шины", "Python", "Читает детекции и телеметрию, приводит к общему виду события фермы")
  Component(dedup, "Дедупликация", "Python", "Отбрасывает повторную доставку по идентификатору события")
  Component(state, "Состояние фермы", "Python", "Держит в памяти последние показания по загонам и оборудованию, периодически сохраняет снимок")
  Component(engine, "Движок правил", "Python", "Прогоняет событие через включённые правила и решает, создавать ли инцидент")
  Component(rules, "Набор правил", "Python", "Драка, задавливание поросят, болезнь, пересчёт поголовья, отказ фильтрации. Пороги берутся из БД")
  Component(suppress, "Подавление повторов", "Python", "Схлопывает поток однотипных детекций в один инцидент по ключу тип-загон-окно")
  Component(repo, "Репозитории", "Python", "Инциденты, пороги правил, обработанные события. Только они ходят в БД")
  Component(alarm, "Отправка тревоги", "Python", "Сирена и уведомление на панель, приоритет берётся из инцидента")
  Component(api, "API инцидентов", "Python", "Список и карточка инцидента для панели")
}

Rel(bus, consumer, "Детекции и телеметрия")
Rel(consumer, dedup, "Проверка идентификатора")
Rel(dedup, repo, "Обработанные события")
Rel(consumer, state, "Обновляет показания")
Rel(consumer, engine, "Событие, если это не повтор")
Rel(engine, state, "Читает текущее состояние загона")
Rel(engine, rules, "Прогоняет по включённым правилам")
Rel(rules, repo, "Пороги правил")
Rel(engine, suppress, "Проверяет, был ли такой инцидент")
Rel(suppress, repo, "Недавние инциденты")
Rel(engine, repo, "Сохраняет инцидент")
Rel(engine, alarm, "Инцидент к оповещению")
Rel(alarm, siren, "Тревога")
Rel(alarm, panel, "Уведомление")
Rel(repo, farmdb, "Чтение и запись", "SQL")
Rel(panel, api, "Список инцидентов", "REST")
Rel(api, repo, "Инциденты")
Rel(duty, panel, "Смотрит и подтверждает")
Rel(repo, sync, "Инциденты на отправку в центр")
Rel(sync, repo, "Новые пороги правил из центра")

SHOW_LEGEND()
@enduml
