@startuml C1-alternative
!include <C4/C4_Context>

title C1. Вариант B (альтернативный): тонкий шлюз на ферме, обработка в центре

Enterprise_Boundary(farm, "Ферма, одна из N. Своей логики нет") {
  Person(duty, "Дежурный на ферме", "Реагирует на месте, оповещение приходит из центра")

  System(gateway, "Шлюз фермы (новое)", "Недорогой узел: подключает камеры и контроллеры, передаёт видео и телеметрию в центр, транслирует обратно команды. Своей аналитики нет, при обрыве связи только буферизует телеметрию")

  System_Ext(cameras, "Видеокамеры", "Разные производители, ночная съёмка")
  System_Ext(equipment, "Кормушки, поилки, фильтрация воды", "Контроллеры разных производителей")
  System_Ext(siren, "Сирена и световая сигнализация", "Включается командой из центра")
}

Enterprise_Boundary(hq, "Головной офис, здесь вся обработка") {
  Person(operator, "Оператор мониторинга", "Разбирает инциденты со всех ферм")
  Person(zoo, "Зоотехник, ветеринар", "Состояние животных и поголовье")
  Person(admin, "Администратор платформы", "Роли, пороги правил, подключение ферм")
  System(central, "Центральная платформа (новое)", "Вся обработка здесь: видеоаналитика по всем фермам, правила инцидентов, оповещения, история, справочники, роли, API")

  System_Boundary(landscape, "Существующий ландшафт, переиспользуем шире, чем в варианте A") {
    System(iot, "IoT-платформа", "Node-RED, TimescaleDB. Распространяем на фермы")
    System(apps, "Веб-портал и мобильное приложение", "React, Flutter. Добавляем экраны животноводства")
    System(kafka, "Kafka", "Корпоративная шина данных")
    System(storage, "Data Lake, DWH, BI", "MinIO, ClickHouse, Power BI, расчёты на Spark")
    System(erp, "ERP 1С:Агро", "Склад, закупки, кадры")
  }
}

System_Ext(mlmodel, "ML-модели партнёра", "Готовые модели распознавания")
System_Ext(idp, "Корпоративный SSO")

Rel(cameras, gateway, "Видеопоток", "RTSP, локальная сеть")
BiRel(gateway, equipment, "Транслирует команды, собирает статусы", "через адаптеры")
Rel(gateway, siren, "Включает сирену")

Rel(gateway, central, "Видеопотоки всех ферм на анализ", "нестабильный WiFi и 4G, узкое место")
Rel(gateway, iot, "Телеметрия оборудования")
Rel(central, gateway, "Команды оборудованию, включение сирены")
Rel(central, duty, "Оповещение о ЧП, только если есть связь с фермой")
BiRel(central, kafka, "Телеметрия ферм в правила инцидентов, метрики платформы обратно в шину")
Rel(iot, kafka, "Телеметрия")
Rel(mlmodel, central, "Обученные модели")

Rel(operator, apps, "Разбирает инциденты")
Rel(zoo, apps, "Состояние животных, поголовье")
Rel(admin, central, "Роли, пороги правил, подключение ферм")
Rel(apps, central, "Данные и действия пользователя", "REST")
Rel(central, idp, "Аутентификация, роли")
Rel(kafka, storage, "Данные для аналитики")
Rel(storage, central, "Прогноз расхода корма")
BiRel(central, erp, "Фактический расход и заявки на закупку, кадры для дежурств")

SHOW_LEGEND()
@enduml
