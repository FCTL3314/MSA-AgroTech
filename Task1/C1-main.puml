@startuml C1-main
!include <C4/C4_Context>

title C1. Вариант A (основной): автономный агент на ферме, центральная платформа в офисе

Enterprise_Boundary(farm, "Ферма, одна из N (сейчас 150 площадок)") {
  Person(duty, "Дежурный на ферме", "Реагирует на месте, оповещение должно доходить и без интернета")

  System(agent, "Агент фермы (новое)", "Локальный сервер и edge-устройства. Видеоаналитика, правила инцидентов, управление оборудованием, оповещение дежурного, своё хранилище. Работает без связи с центром")

  System_Ext(cameras, "Видеокамеры", "Разные производители, ночная съёмка")
  System_Ext(equipment, "Кормушки, поилки, фильтрация воды", "Контроллеры разных производителей")
  System_Ext(siren, "Сирена и световая сигнализация")
}

Enterprise_Boundary(hq, "Головной офис") {
  Person(operator, "Оператор мониторинга", "Разбирает инциденты со всех ферм")
  Person(zoo, "Зоотехник, ветеринар", "Состояние животных и поголовье")
  Person(admin, "Администратор платформы", "Роли, пороги правил, подключение ферм")

  System(central, "Центральная платформа (новое)", "Одна на систему: реестр ферм, история инцидентов, справочники, роли, конфигурация правил, раздача моделей, API для приложений")

  System_Boundary(landscape, "Существующий ландшафт, переиспользуем") {
    System(apps, "Веб-портал и мобильное приложение", "React, Flutter. Добавляем экраны животноводства")
    System(kafka, "Kafka", "Корпоративная шина данных")
    System(storage, "Data Lake, DWH, BI", "MinIO, ClickHouse, Power BI, расчёты на Spark")
    System(erp, "ERP 1С:Агро", "Склад, закупки, кадры")
  }
}

System_Ext(mlmodel, "ML-модели партнёра", "Готовые модели распознавания")
System_Ext(idp, "Корпоративный SSO")

Rel(cameras, agent, "Видеопоток", "RTSP, локальная сеть")
BiRel(agent, equipment, "Команды кормления и поения, статусы", "через адаптеры")
Rel(agent, siren, "Поднимает тревогу")
Rel(agent, duty, "Оповещение о ЧП, до 5 секунд, работает без интернета")

Rel(agent, central, "События, инциденты, метрики. После обрыва связи досылает накопленное")
Rel(central, agent, "Конфигурация, справочники, обновления модели. Задержка до 10 минут")
Rel(mlmodel, central, "Обученные модели")

Rel(operator, apps, "Разбирает инциденты")
Rel(zoo, apps, "Состояние животных, поголовье")
Rel(admin, central, "Роли, пороги правил, подключение ферм")
Rel(apps, central, "Данные и действия пользователя", "REST")
Rel(central, idp, "Аутентификация, роли")
Rel(central, kafka, "Базовые и пользовательские метрики")
Rel(kafka, storage, "Данные для аналитики")
Rel(storage, central, "Прогноз расхода корма")
BiRel(central, erp, "Фактический расход и заявки на закупку, кадры для дежурств")

SHOW_LEGEND()
@enduml
